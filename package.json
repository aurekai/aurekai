{
  "name": "@aurekai/runtime",
  "version": "0.8.0",
  "description": "Aurekai — the operating fabric for intelligent work.",
  "type": "module",
  "homepage": "https://aurekai.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurekai/aurekai.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "aurekai",
    "akai",
    "runtime",
    "appliance",
    "semantic-memory",
    "proof",
    "sae",
    "fpqx"
  ],
  "bin": {
    "akai": "bin/akai.mjs",
    "aurekai": "bin/akai.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "help": "node ./bin/akai.mjs --help",
    "doctor": "node ./bin/akai.mjs doctor --deep",
    "dashboard": "node ./bin/akai.mjs dashboard",
    "manifest": "node ./bin/akai.mjs manifest:print",
    "manifest:render": "node ./src/render-manifest.mjs",
    "test:weightops-envelope": "node ./scripts/validate-weightops-envelope.mjs",
    "test:cas-chunking": "node ./scripts/validate-cas-chunking.mjs",
    "test:delta-planner": "node ./scripts/validate-delta-planner.mjs",
    "test:benchmark-gates": "node ./scripts/validate-benchmark-gates.mjs",
    "test:manifest-signing": "node ./scripts/validate-manifest-signing.mjs",
    "test:integrity-signature-policy": "node ./scripts/validate-integrity-signature-policy.mjs",
    "test:mmap-zerocopy": "node ./scripts/validate-mmap-zerocopy.mjs",
    "test:drift-distribution": "node ./scripts/validate-drift-distribution.mjs",
    "test:pack": "node ./scripts/validate-pack.mjs",
    "test:fetch": "node ./scripts/validate-fetch.mjs",
    "test:hydrate-engine": "node ./scripts/validate-hydrate-engine.mjs",
    "test:serving-readiness": "node ./scripts/validate-serving-readiness.mjs",
    "test:promotion-gates": "node ./scripts/validate-promotion-gates.mjs",
    "test:pipeline-gates": "node ./scripts/validate-pipeline-gates.mjs",
    "test:pipeline-contract": "node ./scripts/validate-pipeline-contract.mjs",
    "test:bench": "node ./scripts/validate-bench.mjs",
    "test:proof-compact": "node ./scripts/validate-proof-compact.mjs",
    "test:pack-optimize": "node ./scripts/validate-pack-optimize.mjs",
    "native:build": "make -C native all",
    "native:check": "make -C native check",
    "release": "make release",
    "release-check": "make release-check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@napi-rs/blake-hash": "^1.3.6"
  }
}
