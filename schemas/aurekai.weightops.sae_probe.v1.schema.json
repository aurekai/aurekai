{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aurekai.weightops.sae_probe.v1.schema.json",
  "title": "Aurekai WeightOps SAE Probe",
  "description": "Output of akai weights sae-probe",
  "type": "object",
  "required": ["schema_version", "model_ref", "features_probed", "probe_results", "proof_hash"],
  "properties": {
    "schema_version": { "type": "string", "const": "aurekai.weightops.sae_probe.v1" },
    "model_ref": { "type": "string" },
    "features_probed": { "type": "array", "items": { "type": "string" } },
    "layer_scope": { "type": "string" },
    "top_k": { "type": "integer" },
    "probe_results": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "proof_hash": { "type": "string" },
    "dry_run": { "type": "boolean" }
  },
  "additionalProperties": true
}
