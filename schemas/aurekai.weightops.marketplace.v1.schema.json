{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aurekai.weightops.marketplace.v1.schema.json",
  "title": "Aurekai WeightOps — Marketplace / Recommender Result",
  "description": "Output of `akai weights marketplace`. Returns ranked model recommendations scored against task constraints, budget, and disk.",
  "type": "object",
  "required": ["schema_version", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "aurekai.weightops.marketplace.v1" },
    "generated_at":   { "type": "string", "format": "date-time" },
    "query": {
      "type": "object",
      "properties": {
        "tasks":       { "type": "array",  "items": { "type": "string" } },
        "budget_gb":   { "type": "number" },
        "disk_gb":     { "type": "number" },
        "quality_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_n":       { "type": "integer" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "id", "name", "size_gb", "recommendation_score", "proof_hash"],
        "properties": {
          "rank":                  { "type": "integer" },
          "id":                    { "type": "string" },
          "name":                  { "type": "string" },
          "family":                { "type": "string" },
          "size_gb":               { "type": "number" },
          "cost_credits_per_hr":   { "type": "number" },
          "sae_compatible":        { "type": "boolean" },
          "memory_pack_available": { "type": "boolean" },
          "matched_features":      { "type": "array", "items": { "type": "string" } },
          "recommendation_score":  { "type": "number" },
          "ghost_ready":           { "type": "boolean" },
          "download_strategy":     { "type": "string" },
          "proof_hash": { "type": "string", "pattern": "^ak:sha256:[0-9a-f]{32}$" }
        }
      }
    },
    "best_match": { "type": ["string", "null"] },
    "catalog_size":{ "type": "integer" },
    "models": { "type": "array" },
    "proof_hash": { "type": "string", "pattern": "^ak:sha256:[0-9a-f]{32}$" }
  },
  "additionalProperties": false
}
