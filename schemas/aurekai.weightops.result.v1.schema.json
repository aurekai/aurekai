{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aurekai.weightops.result.v1.schema.json",
  "title": "Aurekai WeightOps Result Envelope",
  "description": "Universal envelope for all WeightOps command results — provides consistent output format for dashboards, MCP, CI/CD, ML platforms, and LLM provider integrations",
  "type": "object",
  "required": ["schema_version", "command", "status", "created_at", "proof_root"],
  "properties": {
    "schema_version":     { "type": "string", "const": "aurekai.weightops.result.v1" },
    "command":            { "type": "string", "description": "WeightOps command executed (e.g. 'weights.sbom', 'weights.tamper-detect')" },
    "model_ref":          { "type": "string", "description": "Model artifact reference or identifier" },
    "input_artifacts": {
      "type": "array",
      "description": "Artifacts consumed by this command",
      "items": {
        "type": "object",
        "properties": {
          "type":    { "type": "string", "enum": ["model", "sbom", "schema", "memory", "distill", "delta", "trace"] },
          "path":    { "type": "string" },
          "hash":    { "type": "string" },
          "size_mb": { "type": "number" }
        }
      }
    },
    "output_artifacts": {
      "type": "array",
      "description": "Artifacts produced by this command",
      "items": {
        "type": "object",
        "properties": {
          "type":    { "type": "string", "enum": ["sbom", "proof", "delta", "plan", "result"] },
          "path":    { "type": "string" },
          "hash":    { "type": "string" },
          "size_mb": { "type": "number" }
        }
      }
    },
    "proof_root":         { "type": "string", "description": "Root proof hash for the operation" },
    "bytes_read":         { "type": "integer", "description": "Total bytes read from input artifacts" },
    "bytes_written":      { "type": "integer", "description": "Total bytes written to output artifacts" },
    "model_state_delta": {
      "type": "object",
      "description": "Summary of model mutations (e.g. quantization, patching, freezing)",
      "properties": {
        "regions_modified": { "type": "integer" },
        "bytes_delta":      { "type": "integer" },
        "operations":       { "type": "array", "items": { "type": "string" } }
      }
    },
    "status":             { "type": "string", "enum": ["PASS", "FAIL", "PARTIAL", "SKIP"], "description": "Operation status" },
    "exit_code":          { "type": "integer", "description": "Process exit code (0=success)" },
    "warnings":           { "type": "array", "items": { "type": "string" }, "description": "Non-fatal warnings" },
    "errors":             { "type": "array", "items": { "type": "string" }, "description": "Error messages if status=FAIL" },
    "created_at":         { "type": "string", "format": "date-time", "description": "Timestamp when command executed" },
    "duration_ms":        { "type": "integer", "description": "Command execution duration in milliseconds" },
    "payload":            { "type": "object", "description": "Command-specific result payload (sbom data, tamper-detect results, etc.)" }
  },
  "additionalProperties": false
}
